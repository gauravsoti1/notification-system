POSTGRES_USER=choose_a_postgres_username
POSTGRES_PASSWORD=choose_a_strong_postgres_password
POSTGRES_DB=notification_system_db
RABBITMQ_USER=choose_a_rabbitmq_username
RABBITMQ_PASSWORD=choose_a_strong_rabbitmq_password

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Full connection string used by the app and migrations. Must match the POSTGRES_* values above.
# Values are not interpolated, so write them out. Percent-encode special characters in the password.
DATABASE_URL=postgres://YOUR_POSTGRES_USER:YOUR_POSTGRES_PASSWORD@localhost:5433/YOUR_POSTGRES_DB
