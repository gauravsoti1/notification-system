{
  "name": "notification-system",
  "version": "1.0.0",
  "description": "A distributed notification system",
  "homepage": "https://github.com/gauravsoti1/notification-system#readme",
  "bugs": {
    "url": "https://github.com/gauravsoti1/notification-system/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gauravsoti1/notification-system.git"
  },
  "license": "ISC",
  "author": "Gaurav Sobti",
  "type": "module",
  "main": "dist/app.js",
  "scripts": {
    "test": "npm run test:unit",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/app.js",
    "dev": "tsx watch src/app.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "migrate": "node-pg-migrate -j ts",
    "migrate:up": "node --env-file=.env node_modules/node-pg-migrate/bin/node-pg-migrate.js -j ts up",
    "migrate:down": "node --env-file=.env node_modules/node-pg-migrate/bin/node-pg-migrate.js -j ts down",
    "test:unit": "vitest run tests/unit",
    "test:db": "vitest run tests/integration/schema.test.ts",
    "test:worker": "vitest run tests/integration/worker.test.ts",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest tests/unit",
    "worker": "tsx src/jobQueue/worker.ts",
    "dev:worker": "tsx watch src/jobQueue/worker.ts"
  },
  "dependencies": {
    "amqplib": "^2.3.1",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "redis": "^6.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "node-pg-migrate": "^9.0.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
